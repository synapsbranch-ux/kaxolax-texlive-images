    "texContains": [
      "\\section{Introduction}",
      "\\footnote{Le texte de la note.}",
      "\\begin{longtable}",
      "\\begin{Shaded}",
      "\\int_0^1 x^2",
      "{figures/plot.png}",
      "{media/1630582cb4d9471b8d5c8ee5048ddc5b6b0662f8.png}",
      "\\title{Conversion Markdown}",
      "%KAXOLAX-BODY-BEGIN-"
    ],
    "reportContains": ["\"kind\":\"project\"", "\"kind\":\"embedded\""],
    "logLacks": ["Undefined control sequence", "not found"]
  }
}
