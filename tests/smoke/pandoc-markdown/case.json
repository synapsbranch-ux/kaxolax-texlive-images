{
  "description": "pandoc : Markdown riche (titres, listes, tâches, formules, tableau, code coloré, note, citation, image du projet et image data:) converti en document LaTeX complet, puis compilé par pdfLaTeX.",
  "convert": { "mode": "document", "documentClass": "article", "compile": "pdflatex" },
  "timeoutSeconds": 60,
  "expect": {
    "status": ["success"],
